---
import { sitePath } from '../lib/paths';
import '../styles/global.css';
import '../styles/atlas.css';
import Header from '../components/Header';
import type { Track } from '../data/types';
interface Props { title?: string; description?: string; active?: Track; explorer?:boolean; topicTitle?:string; topicPath?:string }
const { title = '全球 AI 时间线', description = '探索全球人工智能发展史：技术方法、Agent 产品与模型版本，每个重要事件都有来源。', active = 'history', explorer=false, topicTitle, topicPath } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#ffffff" /><title>{title} · timeline</title><link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" /><meta property="og:title" content={`${title} · timeline`} /><meta property="og:description" content={description} /></head>
  <body>
    <a href="#main" class="skip-link">跳到主要内容</a>
    {explorer ? <slot /> : <><Header topicTitle={topicTitle} topicPath={topicPath} active={Astro.url.pathname.endsWith('/about/')?'about':active==='history'?'timeline':'themes'}/><main id="main" class="record-content"><slot /></main><footer class="atlas-footer"><span><strong>timeline</strong><i/>理解过去 · 看见可能的未来</span><a href={sitePath('/about/')}>收录原则与资料来源</a></footer></>}
  </body>
</html>
