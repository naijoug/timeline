---
import CollectionPage from '../../../components/timeline/CollectionPage.astro';
import { chinaHistory } from '../../../topics/china-history/catalog';
import { sitePath } from '../../../lib/paths';
const collection = chinaHistory.timelines!.find(collection => collection.id === 'idiom-backgrounds')!;
const entityHref = (id: string) => sitePath(`/china-history/objects/${id}/`);
---
<CollectionPage catalog={chinaHistory} collection={collection} entityHref={entityHref} />
