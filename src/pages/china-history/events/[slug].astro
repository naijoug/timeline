---
import Layout from '../../../layouts/Layout.astro';
import { chinaHistory } from '../../../topics/china-history/catalog';
import { formatTime } from '../../../core/time';
import { sitePath } from '../../../lib/paths';
import EventRecord from '../../../components/timeline/EventRecord.astro';
import Relations from '../../../components/timeline/Relations.astro';
import { eventSourceIds, relationsFor } from '../../../core/evidence';
export function getStaticPaths() { return chinaHistory.events.map(event=>({params:{slug:event.id},props:{event}})); }
const { event } = Astro.props;
const category = chinaHistory.topic.categories.find(c=>c.id===event.category)!;
const sourceIds = new Set([...eventSourceIds(event), ...relationsFor(chinaHistory,event.id).flatMap(r=>r.sourceIds)]);
const sources = chinaHistory.sources.filter(s=>sourceIds.has(s.id));
const periods = chinaHistory.periods.filter(p=>event.periodIds.includes(p.id));
const objects = chinaHistory.entities.filter(e=>event.entityIds.includes(e.id) && !chinaHistory.periods.some(p=>p.entityIds.includes(e.id)));
const entityHref = (id:string) => sitePath(`/china-history/objects/${id}/`);
---
<Layout title={`${event.title} · 中国历史`} description={event.summary} topicTitle="中国历史" topicPath="/china-history/">
  <EventRecord topicPath="/china-history/" topicTitle="中国历史" title={event.title} category={category.title} date={formatTime(event.time)} summary={event.summary} significance={event.significance} milestone={event.milestone} details={event.details}
    note={event.note || (event.time.start.day ? '按资料所列公历日期展示。' : event.time.start.month ? '按月份精度展示，不补造具体日期。' : '按年份精度展示；年份节点不表示事件发生于某个确定月日。')} sources={sources}
    related={[...periods.map(period=>({title:period.title,label:formatTime(period.time),href:sitePath(`/china-history/dynasties/${period.id}/`)})), ...objects.map(o=>({title:o.name,label:o.type,href:entityHref(o.id)}))]}
    facts={[{label:'时间精度',value:event.time.start.day?'日期':event.time.start.month?'月份':'年份'},{label:'类别',value:category.title},{label:'时间类型',value:event.time.kind==='duration'?'持续过程':event.time.kind==='uncertain'?'日期范围待考':'时间节点'}]}>
    <div slot="related"><Relations catalog={chinaHistory} eventId={event.id} entityHref={entityHref} /></div>
  </EventRecord>
</Layout>
