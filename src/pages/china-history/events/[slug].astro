---
import Layout from '../../../layouts/Layout.astro';
import { chinaHistory } from '../../../topics/china-history/catalog';
import { formatTime } from '../../../core/time';
import { sitePath } from '../../../lib/paths';
import '../../../styles/explorer.css';
export function getStaticPaths() { return chinaHistory.events.map(event=>({params:{slug:event.id},props:{event}})); }
const { event } = Astro.props;
const category = chinaHistory.topic.categories.find(c=>c.id===event.category)!;
const sources = chinaHistory.sources.filter(s=>event.sourceIds.includes(s.id));
const periods = chinaHistory.periods.filter(p=>event.periodIds.includes(p.id));
---
<Layout title={`${event.title} · 中国历史`} description={event.summary} topicTitle="中国历史" topicPath="/china-history/">
  <a class="back-link" id="history-return" href={sitePath('/china-history/')} data-prefix={sitePath('/china-history/')}>← 返回时间线</a>
  <article class="full-event"><header class="event-hero"><div class="eyebrow">{category.title} · 中国历史</div><h1>{event.title}</h1><p class="detail-subtitle">{formatTime(event.time)}</p><p class="detail-lead">{event.summary}</p></header>
    <div class="article-layout"><div class="article-body"><section><h2>为什么重要</h2><p>{event.significance}</p></section>{event.details?.map(d=><section><h2>{d.label}</h2><p>{d.text}</p></section>)}<section><h2>日期与阅读说明</h2><p>{event.note || '首版按年份精度展示。年份节点不表示事件发生于该年的某个确定月日。'}</p>{event.time.kind==='duration'&&<p>这是一段持续过程，时间窗口与它相交时仍会显示。</p>}</section><section><h2>资料来源</h2><div class="source-list">{sources.map(s=><a class="source-item" href={s.url} target="_blank" rel="noopener noreferrer"><div><strong>{s.title}</strong><span>{s.publisher} · {s.type} · 核查于 {s.checkedAt}</span></div><span>↗</span></a>)}</div><p class="source-note">事实与日期依据上述资料；“为什么重要”为本站编辑概述。参考资料的纪年口径可能存在差异。</p></section></div><aside class="article-aside"><div class="rail-heading">相关朝代与时期</div>{periods.map(p=><a class="entity-reference" href={sitePath(`/china-history/dynasties/${p.id}/`)}><span>{formatTime(p.time)}</span><strong>{p.title} →</strong></a>)}<a class="copy-link" href={sitePath('/china-history/themes/battles/')}>探索重大战役</a></aside></div>
  </article>
</Layout>
<script>
  const back = document.querySelector<HTMLAnchorElement>('#history-return');
  const value = new URLSearchParams(location.search).get('return');
  if (back && value) { try { const url=new URL(value,location.origin); if(url.origin===location.origin&&url.pathname.startsWith(back.dataset.prefix!)) back.href=url.pathname+url.search; } catch {} }
</script>
