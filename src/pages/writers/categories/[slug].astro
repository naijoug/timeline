---
import Layout from '../../../layouts/Layout.astro';
import Explorer from '../../../components/timeline/Explorer';
import { writersCatalog } from '../../../topics/writers/catalog';
import { writersPresentation } from '../../../topics/writers/presentation';

export function getStaticPaths() {
  return writersCatalog.topic.categories.map(category => ({ params: { slug: category.id }, props: { category } }));
}

const { category } = Astro.props;
---
<Layout explorer title={`${category.title} · 作家作品时间线`} description={`按“${category.title}”筛选作家作品发布时间线。`}><Explorer catalog={writersCatalog} initialCategory={category.id} presentation={writersPresentation} client:load /></Layout>
