---
import Layout from '../../../layouts/Layout.astro';
import Explorer from '../../../components/timeline/ExplorerIsland.astro';
import { writersCatalog } from '../../../topics/writers/catalog';

export function getStaticPaths() {
  return writersCatalog.topic.categories.map(category => ({ params: { slug: category.id }, props: { category } }));
}

const { category } = Astro.props;
---
<Layout explorer title={`${category.title} · 作家作品时间线`} description={`按“${category.title}”筛选作家作品发布时间线。`}><Explorer topicId="writers" initialCategory={category.id} /></Layout>
