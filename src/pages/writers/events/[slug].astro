---
import Layout from '../../../layouts/Layout.astro';
import EventRecord from '../../../components/timeline/EventRecord.astro';
import RecommendedReading from '../../../components/timeline/RecommendedReading.astro';
import Relations from '../../../components/timeline/Relations.astro';
import { eventSourceIds, relationsFor } from '../../../core/evidence';
import { writersCatalog } from '../../../topics/writers/catalog';
import { formatTime } from '../../../core/time';
import { sitePath } from '../../../lib/paths';

export function getStaticPaths() {
  return writersCatalog.events.map(event => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const category = writersCatalog.topic.categories.find(c => c.id === event.category)!;
const periods = writersCatalog.periods.filter(p => event.periodIds.includes(p.id));
const authors = writersCatalog.entities.filter(e => event.entityIds.includes(e.id));
const sourceIds = new Set([...eventSourceIds(event), ...relationsFor(writersCatalog, event.id).flatMap(relation => relation.sourceIds)]);
const sources = writersCatalog.sources.filter(source => sourceIds.has(source.id));
const facts = [
  { label: '节点时间', value: formatTime(event.time) },
  { label: '体裁类别', value: category.title },
  { label: '创作作者', value: authors.map(a => a.name).join('、') || '见正文' },
  ...(event.facts?.map(f => ({ label: f.label, value: f.text, sourceIds: f.sourceIds })) || []),
];
---
<Layout title={`${event.title} · 作家作品`} description={event.summary} topicTitle="作家作品" topicPath="/writers/">
  <EventRecord topicPath="/writers/" topicTitle="作家作品" title={event.title} category={category.title} date={formatTime(event.time)} summary={event.summary} significance={event.significance} milestone={event.milestone} details={event.details} note={event.note || (event.time.start.day ? '按资料所列日期展示节点时间。' : event.time.start.month ? '按月份精度展示节点时间。' : '按年份精度展示；年份节点不表示确切月日。')} sources={sources}
    related={[...periods.map(p => ({ title: p.title, label: formatTime(p.time), href: sitePath(`/writers/eras/${p.id}/`) })), ...authors.map(a => ({ title: a.name, label: a.type, href: sitePath(`/writers/authors/${a.id}/`) }))]}
    facts={facts}><RecommendedReading slot="further-reading" resources={event.recommendedResources} /><Relations slot="related" catalog={writersCatalog} eventId={event.id} /></EventRecord>
</Layout>
