---
import Layout from '../../../layouts/Layout.astro';
import Explorer from '../../../components/timeline/ExplorerIsland.astro';
import { writersCatalog } from '../../../topics/writers/catalog';

export function getStaticPaths() {
  return writersCatalog.periods.map(period => ({ params: { slug: period.id }, props: { period } }));
}

const { period } = Astro.props;
---
<Layout explorer title={`${period.title} · 喜爱作家`} description={period.summary}><Explorer topicId="writers" initialPeriod={period.id} /></Layout>
