---
import Layout from '../../../layouts/Layout.astro';
import { writersCatalog } from '../../../topics/writers/catalog';
import { sitePath } from '../../../lib/paths';
import { formatTime } from '../../../core/time';
import '../../../styles/collections.css';

export function getStaticPaths() {
  return writersCatalog.entities.map(entity => ({ params: { slug: entity.id }, props: { entity } }));
}

const { entity } = Astro.props;
const events = writersCatalog.events.filter(e => e.entityIds.includes(entity.id));
const periods = writersCatalog.periods.filter(p => events.some(e => e.periodIds.includes(p.id)));
const sources = writersCatalog.sources.filter(s => entity.sourceIds.includes(s.id));
---
<Layout title={`${entity.name} · 作家作品年谱`} description={`${entity.name}作品发布时间线、内容简介与代表作列表。`} topicTitle="作家作品" topicPath="/writers/">
  <a class="back-link" href={sitePath('/writers/')}>返回作家作品时间线</a>
  <header class="entity-hero"><div class="eyebrow">{entity.type}</div><h1>{entity.name}</h1><p>已收录 {events.length} 部代表作与关键出版节点，记录创作分期、核心梗概与出版资料依据。</p></header>
  <section><h2>作品年表</h2><ol class="collection-nodes">{events.map(e => <li><time>{formatTime(e.time)}</time><div><a href={sitePath(`/writers/events/${e.id}/`)}>{e.title}</a><p>{e.summary}</p></div></li>)}</ol></section>
  <section><h2>创作分期</h2><p>{periods.map(p => p.title).join('、') || '当代'}</p></section>
  <section id="sources"><h2>资料与出版依据</h2>{sources.map(s => <p><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a><small class="evidence-locator">{s.type} · 核查于 {s.checkedAt} · {s.locator}</small></p>)}</section>
</Layout>
