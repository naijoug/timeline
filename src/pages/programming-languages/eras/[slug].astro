---
import Layout from '../../../layouts/Layout.astro';
import Explorer from '../../../components/timeline/ExplorerIsland.astro';
import { programmingLanguages } from '../../../topics/programming-languages/catalog';

export function getStaticPaths() {
  return programmingLanguages.periods.map(period => ({ params: { slug: period.id }, props: { period } }));
}

const { period } = Astro.props;
---
<Layout explorer title={`${period.title} · 编程语言时间线`} description={period.summary}><Explorer topicId="programming-languages" initialPeriod={period.id} /></Layout>
