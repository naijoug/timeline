---
import Layout from '../../../layouts/Layout.astro';
import Explorer from '../../../components/timeline/ExplorerIsland.astro';
import { programmingLanguages } from '../../../topics/programming-languages/catalog';

export function getStaticPaths() {
  return programmingLanguages.topic.categories.map(category => ({ params: { slug: category.id }, props: { category } }));
}

const { category } = Astro.props;
---
<Layout explorer title={`${category.title} · 编程语言时间线`} description={`按“${category.title}”筛选编程语言时间线。`}><Explorer topicId="programming-languages" initialCategory={category.id} /></Layout>
