---
import Layout from '../../../layouts/Layout.astro';
import EventRecord from '../../../components/timeline/EventRecord.astro';
import { programmingLanguages } from '../../../topics/programming-languages/catalog';
import { formatTime } from '../../../core/time';
import { sitePath } from '../../../lib/paths';

export function getStaticPaths() {
  return programmingLanguages.events.map(event => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const category = programmingLanguages.topic.categories.find(c => c.id === event.category)!;
const periods = programmingLanguages.periods.filter(p => event.periodIds.includes(p.id));
const languages = programmingLanguages.entities.filter(e => event.entityIds.includes(e.id));
const sources = programmingLanguages.sources.filter(s => event.sourceIds.includes(s.id));
const changeSources = event.change?.sourceIds || [];
const evidenceSources = [...new Set([...sources.map(s => s.id), ...changeSources])]
  .map(id => programmingLanguages.sources.find(s => s.id === id)!)
  .filter(Boolean);
const facts = [
  { label: '时间精度', value: event.time.start.day ? '日期' : event.time.start.month ? '月份' : '年份' },
  { label: '类别', value: category.title },
  { label: '语言对象', value: languages.map(l => l.name).join('、') || '见正文' },
];
---
<Layout title={`${event.title} · 编程语言`} description={event.summary} topicTitle="编程语言" topicPath="/programming-languages/">
  <EventRecord topicPath="/programming-languages/" topicTitle="编程语言" title={event.title} category={category.title} date={formatTime(event.time)} summary={event.summary} significance={event.significance} milestone={event.milestone} details={event.details} note={event.note || (event.time.start.month ? '按月份精度展示；未给出日时不补造具体日期。' : '按年份精度展示；年份节点不表示事件发生于某个确定月日。')} sources={evidenceSources}
    related={[...periods.map(p => ({ title: p.title, label: formatTime(p.time), href: sitePath(`/programming-languages/eras/${p.id}/`) })), ...languages.map(l => ({ title: l.name, label: l.type, href: sitePath(`/programming-languages/languages/${l.id}/`) }))]}
    facts={facts}>
    {event.change && <div slot="change"><section><h2>版本变化</h2><p><strong>比较基线：</strong>{event.change.baseline}</p><ul>{event.change.improvements.map(item => <li>{item}</li>)}</ul><p><strong>边界：</strong>{event.change.tradeoffs}</p><small class="evidence-locator">{event.change.evidence}</small></section></div>}
  </EventRecord>
</Layout>
