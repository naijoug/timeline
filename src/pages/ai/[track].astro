---
import Layout from '../../layouts/Layout.astro';
import Atlas from '../../components/Atlas';
import type { Track } from '../../data/types';
import { trackLabels } from '../../lib/timeline';
export function getStaticPaths() { return ['methods', 'agents', 'models'].map(path => ({ params: { track: path }, props: { track: path === 'agents' ? 'products' : path } })); }
const { track } = Astro.props as { track: Exclude<Track,'history'> };
---
<Layout title={trackLabels[track]} active={track} explorer><Atlas client:load initialLane={track} /></Layout>
