---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import { sitePath } from '../lib/paths';
import { ArrowUpRight } from 'lucide-react';
import { events as aiEvents } from '../topics/ai/events';
import { programmingLanguages } from '../topics/programming-languages/catalog';
import { chinaHistory } from '../topics/china-history/catalog';
import { writersCatalog } from '../topics/writers/catalog';
import '../styles/library.css';

const aiYears = aiEvents.map(event => Number(event.date.slice(0, 4)));
const languageYears = programmingLanguages.events.map(event => event.time.start.year);
const writerYears = writersCatalog.events.map(event => event.time.start.year);
const yearRange = (years: number[]) => `${Math.min(...years)} — ${Math.max(...years)}`;
const topics = [
  {
    path: '/ai/', title: 'AI 发展史', range: yearRange(aiYears), category: 'SCIENCE & TECHNOLOGY',
    milestones: ['思想', '学习', '生成', '行动'],
    description: '从技术突破到模型演进、Agent 应用。沿着关键节点，阅读人工智能的发展。',
    mobileDescription: '技术突破、模型演进与 Agent 应用。',
    count: `${aiEvents.length} 个事件`, scope: '技术 / 模型 / Agent',
  },
  {
    path: '/programming-languages/', title: '编程语言', range: yearRange(languageYears), category: 'SCIENCE & TECHNOLOGY',
    milestones: ['编译', '范式', '平台', '安全'],
    description: '从 FORTRAN、Lisp、C 到现代语言，观察抽象、平台与工程目标如何塑造工具。',
    mobileDescription: '从早期语言到现代工具的演进。',
    count: `${programmingLanguages.events.length} 个关键节点`, scope: '范式 / 标准 / 实现',
  },
  {
    path: '/china-history/', title: '中国历史', range: '夏商周 — 当代', category: 'HISTORY & CIVILIZATION',
    milestones: ['早期国家', '帝国与分裂', '近代转型', '当代中国'],
    description: '从夏商周到当代，贯通重要战役、政权更替、制度与社会转型；事件详情区分史实、编辑解读和相关节目。',
    mobileDescription: '从夏商周到当代，读战役与重大转折。',
    count: `${chinaHistory.events.length} 个历史节点`, scope: `${chinaHistory.periods.length} 个朝代与时期`,
  },
  {
    path: '/writers/', title: '作家作品', range: yearRange(writerYears), category: 'LITERATURE & AUTHORS',
    milestones: ['科幻', '推理', '历史', '非虚构'],
    description: '从刘慈欣的科幻史诗、紫金陈的社会派推理到马伯庸的历史小说与微尘叙事，阅读当代作家的出版轨迹与内容简介。',
    mobileDescription: '刘慈欣、紫金陈与马伯庸的出版轨迹。',
    count: `${writersCatalog.events.length} 个作品与传播节点`, scope: '刘慈欣 / 紫金陈 / 马伯庸',
  },
];
---
<Layout explorer title="探索时间线" description="从 AI 发展、编程语言、中国历史到当代作家作品，沿着时间发现事件、时代与主题之间的关联。">
  <Header client:load screen="home" topicTitle="探索时间线" topicPath="/" />
  <main id="main" class="library">
    <p class="library-kicker">TIME, IN CONTEXT</p>
    <h1>沿着时间，<br/><span>看见事物的来路。</span></h1>
    <p class="library-lead">一个主题，一条主线。走进一个时代，展开一段历史，发现事件之间的关联。</p>
    <p class="library-mobile-guide">从一个主题出发，<br/>读懂每一步如何走到今天。</p>
    <div class="library-rule"/>
    <div class="library-label"><span>选择一条线，开始探索</span><span>04 个主题</span></div>
    <div class="topic-cards">
      {topics.map((topic, index) => <a class="topic-card" href={sitePath(topic.path)} data-astro-prefetch>
        <span class="topic-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="topic-card-body">
          <h2>{topic.title}</h2>
          <p class="topic-card-description">{topic.description}</p>
          <p class="topic-card-mobile-description">{topic.mobileDescription}</p>
          <div class="topic-card-meta"><span>{topic.range}</span><span>{topic.count}</span></div>
        </div>
        <span class="topic-card-arrow" aria-hidden="true"><ArrowUpRight size={19} /></span>
        <span class="topic-card-line" aria-hidden="true"><i/><i/><i/></span>
      </a>)}
    </div>
    <p class="library-note">每条时间线都有自己的收录范围。事件与资料持续补充，来源随节点一起保留。</p>
  </main>
  <footer class="atlas-footer"><span><strong>timeline</strong><i/>在时间中，发现关联</span><a href={sitePath('/about/')}>收录范围与资料说明</a></footer>
</Layout>
<script>
  import { sitePath } from '../lib/paths';
  // Before the theme library, the root URL hosted AI. Preserve its shared views.
  const parameters = new URLSearchParams(location.search);
  if (['from','to','lane','event','scope','q','level','company','entity'].some(key=>parameters.has(key))) {
    location.replace(sitePath('/ai/') + location.search + location.hash);
  }
</script>
