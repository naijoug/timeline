---
import TimelinePage from './TimelinePage.astro';
import Relations from './Relations.astro';
import type { Catalog, Collection } from '../../core/types';
import { timelineEvents } from '../../core/timelines';
import { formatTime } from '../../core/time';
import { sitePath } from '../../lib/paths';
interface Props { catalog: Catalog; collection: Collection; entityHref?: (id:string)=>string }
const { catalog, collection, entityHref } = Astro.props;
const selected = timelineEvents(catalog, [collection.id]);
const ids = new Set(selected.map(event => event.id));
const subset = { ...catalog, events: selected, relations: catalog.relations?.filter(relation => ids.has(relation.fromEventId) && (!relation.toEventId || ids.has(relation.toEventId))) };
---
<!-- Legacy collection paths keep their content, now using the shared reading UI. -->
<TimelinePage catalog={catalog} timeline={collection}>
  {catalog.periods.some(period => selected.some(event => event.periodIds.includes(period.id))) && <section class="collection-context"><h2>时期与归属</h2>{catalog.periods.filter(period => selected.some(event => event.periodIds.includes(period.id))).map(period => <p><a href={sitePath(`${catalog.topic.path}${catalog.topic.periodSegment || 'periods'}/${period.id}/`)}>{period.title} · {formatTime(period.time)}</a> — {period.summary}</p>)}</section>}
  <Relations catalog={subset} entityHref={entityHref} returnPath={`${sitePath(collection.path)}#timeline-notes`} />
</TimelinePage>
